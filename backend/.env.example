# SmartMaint IA - Backend environment variables (example)
# Copier ce fichier en .env et adapter les valeurs.

# Application
APP_NAME=SmartMaint IA API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# Base de donnees MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartmaint_ia

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-32-bytes-min-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (liste JSON)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
